# Copie para .env antes de subir a stack com o profile airflow
# AIRFLOW_UID deve ser o UID do usuario do host no Linux (rode `echo $(id -u)`
# e use esse valor, nao o 50000 fixo abaixo) para o Airflow (que roda como UID
# 50000 dentro do container) nao criar data/ e airflow/logs/ como root e
# quebrar a ingestao/promocao com PermissionError. No Docker Desktop para
# Windows/Mac essa variavel e irrelevante - a virtualizacao do Desktop nao
# mapeia UIDs do host, entao o valor abaixo pode ficar como esta.
AIRFLOW_UID=50000
AIRFLOW__API_AUTH__JWT_SECRET=troque-este-segredo-em-producao
